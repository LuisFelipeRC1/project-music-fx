# MusicXD Environment Variables
# Copy this file to .env and fill in the values before running the project.
# Never commit .env to version control.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Database name
POSTGRES_DB=musicxd

# Database user
POSTGRES_USER=musicxd

# Database password (change this in production)
POSTGRES_PASSWORD=musicxd_dev

# ─── API ──────────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string used by the .NET API
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=musicxd;Username=musicxd;Password=musicxd_dev

# Redis connection string used by the .NET API
ConnectionStrings__Redis=redis:6379

# JWT signing secret — must be a long, random, high-entropy string in production
JWT_SECRET=change-me-in-production-use-a-long-random-string

# JWT token issuer
Jwt__Issuer=musicxd-api

# JWT token audience
Jwt__Audience=musicxd-web

# ASP.NET Core environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Public base URL of the API, accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:5000
